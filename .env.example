# Скопируйте в .env и поправьте значения. Файл .env не коммитится.

# PostgreSQL (сервис db; используется и для сборки DATABASE_URL бэкенда в docker compose)
POSTGRES_USER=agile
POSTGRES_PASSWORD=agile
POSTGRES_DB=agile
POSTGRES_PORT=5432

# Бэкенд. Сгенерировать секрет: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:8080"]

# Только для запуска бэкенда вне docker (uv run uvicorn ...). Внутри compose задаётся автоматически.
DATABASE_URL=postgresql+asyncpg://agile:agile@localhost:5432/agile
